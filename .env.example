# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# Em produção (Render), cadastre estas variáveis no painel do serviço.

# --- Banco de dados (obrigatória em produção) ---
# PostgreSQL. No Neon: use a conexão DIRETA (host sem "-pooler"), não a com
# pool, e termine a URL com ?sslmode=require.
# Ex.: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL=

# --- Autenticação (obrigatória sempre) ---
# Segredo de assinatura dos tokens JWT. Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Frontend (obrigatória em produção) ---
# Origem(ns) liberadas no CORS, separadas por vírgula, sem barra no final.
# A primeira também é a base dos links enviados por e-mail.
# Fora de produção, http://localhost:5173 já é liberado automaticamente.
FRONTEND_URL=

# --- Servidor ---
# "production" no Render; em desenvolvimento pode ficar vazio.
NODE_ENV=
# Porta HTTP. O Render define sozinho; localmente o padrão é 3000.
PORT=
# Em produção o Swagger (/api/docs) fica desligado; "true" liga (ex: demonstração).
SWAGGER_ENABLED=

# --- E-mail (verificação de cadastro e recuperação de senha) ---
# Conta Gmail e senha de app (não a senha normal da conta).
# Sem elas o servidor sobe, mas nenhum e-mail é enviado.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- IA dos relatórios (todas opcionais) ---
# Ordem de tentativa: Gemini -> Groq -> OpenRouter -> heurística local.
# Sem nenhuma chave, o relatório usa só a heurística.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
