# Copie para .env.test e ajuste usuário/senha do Postgres LOCAL.
# O nome do banco PRECISA terminar em _test e o host precisa ser local,
# senão a suíte e2e aborta. O banco é criado e migrado na primeira execução.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/sinapse_db_test?schema=public"
